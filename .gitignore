# Dependencies
node_modules/

# Databases & secrets (never commit these)
*.db
*.db-journal
.env
.env.local
.env.*.local

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Local rollback backups (durable backup is git history)
*.html.bak
_built-test.html

# Built frontend bundle — NOT committed. The server rebuilds it every deploy (update.sh GATE "Build
# frontend"), so it is the single source of truth and can never drift from source. Committing it once
# let a source-only commit ship a stale client; the deterministic build stamp + build-time commit/clock
# now also make dist non-reproducible byte-for-byte (build time is embedded), so tracking it is wrong.
dist/
# Build stamp the server serves at /api/v1/version — regenerated by the same build as dist/.
version.json

# Deploy pipeline log (generated on the server, never committed)
deploy/deploy.log
