# ── AirRO Finance API — environment config ───────────────────────────────
# Copy this file to `.env` and adjust. Never commit the real `.env`.

# Server
NODE_ENV=development
PORT=4000

# Database
# Local dev (zero setup): SQLite file relative to the prisma/ schema.
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — switch the datasource provider in
# prisma/schema.prisma to "postgresql" and use a URL like:
# DATABASE_URL="postgresql://user:password@localhost:5432/airro?schema=public"

# Auth — JWT signing
# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated list of allowed origins for the frontend.
# Use "*" only for local development.
CORS_ORIGIN="*"

# Seeding — the bootstrap admin account created by `npm run db:seed` (role gm,
# can administer users). For production set a STRONG password here.
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="1234"

# Seed the extra demo role accounts (owner/hrd/finance/adminfin) with simple
# PINs. Convenient for local dev; set to "false" for any public deployment so
# only the bootstrap admin above is created.
SEED_DEMO_USERS="true"

# ── Offsite backups (production only — see server/.env.production.example) ────
# deploy/backup-offsite.sh reads these to ship an ENCRYPTED copy off the VPS.
# Not needed for local dev. NEVER commit a real BACKUP_PASSPHRASE.
# RCLONE_REMOTE="airro-offsite:airro"
# BACKUP_PASSPHRASE=""     # set → gpg-encrypt before upload; empty → use an rclone crypt remote
# OFFSITE_KEEP_DAYS="90"

# Business timezone — what "today" means. Every business date (delivery board, setoran, asOf)
# is derived in THIS zone, never from the host clock. Bali = WITA = UTC+8.
APP_TZ=Asia/Makassar

# Fleet GPS (Cartrack) — optional. Absent credentials simply mean "not connected": the app boots
# and the GPS panel says so. Never commit real values.
CARTRACK_BASE_URL=https://fleetapi-id.cartrack.com/rest
CARTRACK_USERNAME=
CARTRACK_PASSWORD=
# Zone assumed for a provider timestamp that carries NO offset. Deliberately NOT taken from the
# provider's own default_timezone field (the vehicles report inconsistent values).
CARTRACK_TZ=UTC
CARTRACK_TIMEOUT_MS=12000
